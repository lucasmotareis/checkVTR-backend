API_HOST=homolog_back.pmto8bpm.com.br
TRAEFIK_ROUTER_NAME=frotapm-api-homolog
TRAEFIK_SERVICE_NAME=frotapm-api-homolog
CORS_ALLOWED_ORIGINS=https://homolog_app.pmto8bpm.com.br,https://homolog_front.pmto8bpm.com.br,https://homolog_back.pmto8bpm.com.br

# O Compose fixa SPRING_PROFILES_ACTIVE=docker,homolog.
POSTGRES_DB=frotapm_homolog
POSTGRES_USER=frotapm_homolog
# Preencher com valores novos e exclusivos; vazios impedem subir o Compose.
POSTGRES_PASSWORD=
JWT_SECRET=

PASSWORD_RESET_URL_BASE=https://homolog_front.pmto8bpm.com.br/reset-password
PASSWORD_RESET_FROM_EMAIL=no-reply@docheck.local
EMAIL_VERIFICATION_URL_BASE=https://homolog_front.pmto8bpm.com.br/verify-email
EMAIL_VERIFICATION_FROM_EMAIL=no-reply@docheck.local

# Configurar SMTP de testes, nunca reutilizar automaticamente o SMTP real.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

S3_REGION=sa-east-1
S3_CHECKLIST_BUCKET=homolog-fotos-viaturas
S3_PROFILE_BUCKET=homolog-fotos-viaturas
S3_KEY_PREFIX=homolog
